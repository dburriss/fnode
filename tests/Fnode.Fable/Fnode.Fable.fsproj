<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);FS3370;NU1701</NoWarn>
  </PropertyGroup>

  <!-- Compiled by Fable (`scripts/fable-test.sh`), not by `dotnet test` (it is not in Fnode.slnx):
       the .NET suite lives in ../Fnode.Tests and these are the very same files, run through tiny xUnit
       and FsCheck shims. Runner.generated.fs is written by scripts/fable-gen-runner.fsx (run it before
       building this project). Keep the Compile list in sync with Fnode.Tests.fsproj (the generator reads it). -->
  <ItemGroup>
    <Compile Include="XunitShim.fs" />
    <Compile Include="FsCheckShim.fs" />
    <Compile Include="../Fnode.Tests/PathTests.fs" Link="Fnode.Tests/PathTests.fs" />
    <Compile Include="../Fnode.Tests/NodeOpsTests.fs" Link="Fnode.Tests/NodeOpsTests.fs" />
    <Compile Include="Runner.generated.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Fnode/Fnode.fsproj" />
  </ItemGroup>

</Project>
