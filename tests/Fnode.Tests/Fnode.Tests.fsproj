<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="PathTests.fs" />
    <Compile Include="NodeOpsTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="FsCheck.Xunit.v3" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Fnode.Core/Fnode.Core.fsproj" />
  </ItemGroup>

</Project>
