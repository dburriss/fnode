<Project>

  <!--
    Fable compiles a NuGet package from its F# sources, so each package ships its .fs files and a project file
    under fable/ (next to the lib/ DLLs). A consumer then needs only a plain PackageReference.

    The project file in fable/ is generated here from the Compile list, so it cannot drift from the real one.
    If a package ever depends on Fnode, set FableNeedsFnode=true in that project: the real file holds a
    ProjectReference, which does not exist inside a package, so the generated one names Fnode as a
    PackageReference at the version being packed.

    The generated file must not sit in a folder called fable: Fable then mistakes the project reference for a packed
    Fable package and fails to compile it (see docs/fable.md).
  -->
  <ItemGroup>
    <Content Include="@(Compile)" Pack="true" PackagePath="fable/" />
  </ItemGroup>

  <Target Name="GenerateFableProject" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <FableProjectFile>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)pack-fable-project/$(MSBuildProjectName).fsproj</FableProjectFile>
      <FableFrameworks>$(TargetFrameworks.Replace(';', '%3B'))</FableFrameworks>
    </PropertyGroup>
    <ItemGroup>
      <FableLine Include="&lt;Project Sdk=&quot;Microsoft.NET.Sdk&quot;&gt;" />
      <FableLine Include="  &lt;PropertyGroup&gt;" />
      <FableLine Include="    &lt;TargetFrameworks&gt;$(FableFrameworks)&lt;/TargetFrameworks&gt;" />
      <FableLine Include="  &lt;/PropertyGroup&gt;" />
      <FableLine Include="  &lt;ItemGroup&gt;" />
      <FableLine Include="@(Compile->'    &lt;Compile Include=&quot;%(Identity)&quot; /&gt;')" />
      <FableLine Include="  &lt;/ItemGroup&gt;" />
      <FableLine Condition="'$(FableNeedsFnode)' == 'true'" Include="  &lt;ItemGroup&gt;" />
      <FableLine Condition="'$(FableNeedsFnode)' == 'true'" Include="    &lt;PackageReference Include=&quot;Fnode&quot; Version=&quot;$(Version)&quot; /&gt;" />
      <FableLine Condition="'$(FableNeedsFnode)' == 'true'" Include="  &lt;/ItemGroup&gt;" />
      <FableLine Include="&lt;/Project&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(FableProjectFile)" Lines="@(FableLine)" Overwrite="true" />
    <ItemGroup>
      <Content Include="$(FableProjectFile)" Pack="true" PackagePath="fable/" />
    </ItemGroup>
  </Target>

</Project>
