<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- The package version. scripts/publish.fsx rewrites Version and PackageReleaseNotes here. -->
    <Version>0.1.0</Version>
    <PackageReleaseNotes>`Fnode.Json` (JSON adapter on `Flexi.Json`) and `Fnode.Yaml` (YAML adapter on `Flexi.Yaml`) packages, each
Lockstep releases: one `v*` tag packs and publishes `Fnode.Core`, `Fnode.Json` and `Fnode.Yaml` at the same
`Fnode.Core`: the shared document core. The `Node` tree (`Int` is an exact `int64`, `Timestamp` keeps the original
The package ships its F# sources under `fable/`, so Fable JavaScript and Python projects can use a plain</PackageReleaseNotes>
    <Authors>Devon Burriss</Authors>
    <Copyright>Copyright © 2026 Devon Burriss</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dburriss/fnode</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dburriss/fnode</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <OtherFlags>$(OtherFlags) --nowarn:57</OtherFlags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <!-- The packed FSharp.Core dependency is an explicit minimum, so it does not follow whichever SDK CI installs
       (`10.0.x` resolves to the newest one, whose implicit default can be higher than the one used locally).
       The code uses no FSharp.Core feature newer than this; raise it only when it does. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fnode.Core'">
    <FSharpCoreImplicitPackageVersion>8.0.403</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>
  <!-- TEMPORARY: Flexi.Json / Flexi.Yaml 0.2.0 declare FSharp.Core 11.0.101 (an accident of the SDK that built them).
       Once 0.2.1 is out with an 8.0.403 floor, move the adapters to 8.0.403 like the core and delete this group. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Fnode.Json' Or '$(MSBuildProjectName)' == 'Fnode.Yaml' Or '$(MSBuildProjectName)' == 'Fnode.Conformance' Or '$(MSBuildProjectName)' == 'Fnode.Json.Tests' Or '$(MSBuildProjectName)' == 'Fnode.Yaml.Tests'">
    <FSharpCoreImplicitPackageVersion>11.0.101</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>
</Project>