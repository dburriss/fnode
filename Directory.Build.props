<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- The package version. scripts/publish.fsx rewrites Version and PackageReleaseNotes here. -->
    <Version>0.2.0</Version>
    <PackageReleaseNotes>`Parsed.ScalarText`: the text each `Int`/`Float` node was written as in the source (`1.10`, `1.0`, `1e3`, an integer
`YamlConvert.toNodeLocated`, `toNodeWith` plus the spans, so the non-string-key error can carry a location.
The `Fnode.Yaml` `type.mismatch` error for a non-string mapping key now has a `Location` (the span of the mapping).
**Breaking:** `Parsed` has a new field, `ScalarText`, so code that builds a `Parsed` record literal must set it
`Fnode.Json` and `Fnode.Yaml` need `Flexi.Json` / `Flexi.Yaml` 0.2.1 or newer.
The packed FSharp.Core dependency of all three packages is now an explicit minimum, 8.0.403, instead of the SDK
For duplicate object keys, `Node` keeps every pair (lookups take the first); `Locations` and `ScalarText` describe the
Target frameworks are now `netstandard2.0` and `net10.0` (was `netstandard2.0` and `net8.0`; .NET 8 is out of LTS).</PackageReleaseNotes>
    <Authors>Devon Burriss</Authors>
    <Copyright>Copyright © 2026 Devon Burriss</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dburriss/fnode</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dburriss/fnode</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <OtherFlags>$(OtherFlags) --nowarn:57</OtherFlags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <!-- The packed FSharp.Core dependency is an explicit minimum, so it does not follow whichever SDK CI installs
       (`10.0.x` resolves to the newest one, whose implicit default can be higher than the one used locally).
       The code uses no FSharp.Core feature newer than this, and Flexi.Json / Flexi.Yaml 0.2.1 declare the same
       floor; raise it only when the code needs to. The projects that reference the library projects must not pin
       lower than they do (NU1605). Fnode.Tests stays on the SDK default. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'Fnode.Tests'">
    <FSharpCoreImplicitPackageVersion>8.0.403</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>
</Project>